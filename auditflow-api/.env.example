# ==============================================================
# AuditFlow API — variáveis de ambiente (template)
# Copie para .env e preencha. NÃO commitar o .env com valores reais.
# ==============================================================

# --- Banco de dados (Supabase PostgreSQL) ---
# Sem valor não há default: a aplicação não sobe sem estes três.
SUPABASE_DB_URL=jdbc:postgresql://<host>:6543/postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# --- JWT (segredo HMAC; use uma string longa e aleatória) ---
JWT_SECRET=

# --- CORS ---
# Origens do front separadas por vírgula. Em produção use o domínio real (sem localhost).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- E-mail transacional (Resend) ---
# Sem RESEND_API_KEY os e-mails de convite/reset são criados mas NÃO enviados.
RESEND_API_KEY=
RESEND_FROM=AuditFlow <onboarding@resend.dev>
APP_NOTIFICATIONS_ENABLED=true

# --- URLs da aplicação web (base dos links de ativação/reset e dos e-mails) ---
APP_WEB_URL=http://localhost:3000
APP_PORTAL_URL=http://localhost:3000/portal

# ==============================================================
# Armazenamento de documentos
# ==============================================================
# local = disco (dev/testes)  |  r2 = Cloudflare R2 (produção)
STORAGE_PROVIDER=local

# --- Usado quando STORAGE_PROVIDER=local ---
STORAGE_UPLOAD_DIR=./uploads

# --- Usado quando STORAGE_PROVIDER=r2 (Cloudflare R2, S3-compatível) ---
# Account ID da Cloudflare (o endpoint vira https://<account-id>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
# Opcional: endpoint completo (tem prioridade sobre R2_ACCOUNT_ID).
R2_ENDPOINT=
# Token de API do R2 (Manage R2 API Tokens): Access Key ID + Secret Access Key.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket R2 onde os documentos são gravados.
R2_BUCKET=
